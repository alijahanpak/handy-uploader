{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "./dist",
    "noEmit": false
  },
  "include": ["env.d.ts", "src/lib/**/*", "src/types/**/*", "src/utils/**/*", "src/core/**/*", "src/vue/**/*", "src/element/**/*", "src/composables/**/*", "src/components/**/*"],
  "exclude": ["src/main.ts", "src/App.vue", "**/*.spec.ts", "**/*.test.ts"]
}